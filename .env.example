# Groq API Key (free - 14,400 requests/day)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: change AI model (default: llama-3.1-8b-instant)
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768
# CHAT_MODEL=llama-3.3-70b-versatile

# Supabase (optional - for remote data management)
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Zalo bot (optional) — set as Cloudflare Worker secrets
# Token from the "Zalo Bot Creator" mini app; secret is any random string (16+ chars)
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=
# Who may ask dashboard questions (comma-separated). Get IDs by sending /id to the bot.
ZALO_ADMIN_USER_IDS=
ZALO_ALLOWED_CHAT_IDS=
